# ---------------------------------------------------------------------------
# Rafiq Study — server settings (read by server.js via dotenv).
# Copy to .env and fill in locally. Never commit .env or paste its values anywhere.
# The React frontend does NOT read this file; it gets the Google client id at
# runtime from GET /api/config, so no secrets are ever bundled into the browser.
# ---------------------------------------------------------------------------

# "production" makes the session cookie Secure (HTTPS only) and hides error details.
NODE_ENV=development

# Port of the Express API + built frontend. In development Vite (port 5173)
# proxies /api to this port.
PORT=3000

# Google Cloud → OAuth client of type "Web application".
# Authorized JavaScript origins must include every origin you open the app from:
#   http://localhost:3000   (npm start / production build)
#   http://localhost:5173   (npm run dev — Vite dev server)
#   https://your-domain     (deployment)
GOOGLE_CLIENT_ID=replace-with-google-web-client-id

# Discord OAuth2 (optional — the Discord button is disabled until all three are set).
# Discord Developer Portal → your application → OAuth2:
#   - copy the Client ID and Client Secret below (the secret stays on the server)
#   - add DISCORD_REDIRECT_URI exactly as written here under "Redirects"
# The redirect must point at this server's callback route on the origin users open:
#   development (npm run dev):   http://localhost:5173/api/auth/discord/callback
#   production build (npm start): http://localhost:3000/api/auth/discord/callback
#   deployment:                  https://your-domain/api/auth/discord/callback
DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback

# At least one sign-in provider (Google or Discord) must be configured.

# MongoDB Atlas connection string for a least-privilege database user.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=rafiq_study

# HMAC key for the session cookie; at least 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# ---------------------------------------------------------------------------
# Uploads & sync
# ---------------------------------------------------------------------------
# Maximum size of one uploaded PDF/image attachment, in MB.
MAX_UPLOAD_MB=40
# Total attachment storage per user, in MB.
USER_STORAGE_QUOTA_MB=500
# Unreferenced uploads older than this are deleted after the next sync.
ORPHAN_FILE_GRACE_HOURS=24
# Maximum size of one planner sync request (JSON, excluding attachments), in MB.
SYNC_MAX_MB=12

# ---------------------------------------------------------------------------
# Deployment / network
# ---------------------------------------------------------------------------
# Set ONLY when running behind a reverse proxy / load balancer that sets
# X-Forwarded-For: the number of proxy hops (usually 1). Leaving it unset when you
# are NOT behind a proxy prevents clients from spoofing their IP to dodge rate limits.
# TRUST_PROXY=1
# Public origin of the app (used for CORS/CSRF origin checks), e.g. https://planner.example
# APP_ORIGIN=
# Extra origins allowed to call the API with credentials (comma-separated, never "*").
# ALLOWED_ORIGINS=
# Session lifetime in days.
SESSION_DAYS=14
# debug | info | warn | error | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Rate limits (per client IP unless noted). Window values are in milliseconds.
# ---------------------------------------------------------------------------
# All /api requests.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
# Sign-in attempts (Google + Discord start) per window.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# Discord OAuth callbacks per window (shares AUTH_RATE_LIMIT_WINDOW_MS).
OAUTH_CALLBACK_RATE_LIMIT_MAX=30
# File uploads per signed-in user per window.
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX=60
# Planner syncs per signed-in user per window.
SYNC_RATE_LIMIT_WINDOW_MS=60000
SYNC_RATE_LIMIT_MAX=30

# Timeouts (ms): calls to Google/Discord, whole-request limit, graceful shutdown.
PROVIDER_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=60000
SHUTDOWN_TIMEOUT_MS=10000

# Optional, development only:
# API_PORT=3000        # port Vite proxies /api to (defaults to PORT above)
# VITE_DEV_PORT=5173   # port of the Vite dev server
